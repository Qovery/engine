        "memory": "256Mi"
      }
    },
    "service": {
      "name": "service-name",
      "type": "ClusterIP"
    },
    "tolerations": [
      {
        "effect": "NoSchedule",
        "key": "dedicated",
        "operator": "Exists"
      }
    ]
  },
