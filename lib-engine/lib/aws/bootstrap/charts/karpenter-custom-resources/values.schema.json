{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pools"
  ],
  "properties": {
    "pools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "nodePoolSpec",
          "nodeClassSpec"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^qovery-[a-z0-9]([a-z0-9-]{0,54}[a-z0-9])?$",
            "maxLength": 63
          },
          "nodePoolSpec": {
            "type": "object",
            "required": [
              "template"
            ]
          },
          "nodeClassSpec": {
            "type": "object",
            "required": [
              "role",
              "amiSelectorTerms",
              "subnetSelectorTerms",
              "securityGroupSelectorTerms"
            ]
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "apiVersion",
          "kind",
          "metadata",
          "spec"
        ],
        "additionalProperties": false,
        "properties": {
          "apiVersion": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 253
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "annotations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "spec": {
            "type": "object"
          }
        },
        "oneOf": [
          {
            "properties": {
              "apiVersion": {
                "const": "karpenter.sh/v1"
              },
              "kind": {
                "const": "NodePool"
              }
            }
          },
          {
            "properties": {
              "apiVersion": {
                "const": "karpenter.k8s.aws/v1"
              },
              "kind": {
                "const": "EC2NodeClass"
              }
            }
          }
        ]
      }
    }
  }
}
