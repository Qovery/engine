amends "pkl:test"

import "../contract.pkl"
import "../sdk/evaluate.pkl"
import "../sdk/request.pkl"
import "../sdk/settings.pkl"

local retention: settings.IntSetting = new {
  key = "retentionWeeks"
  label = "Retention"
  default = 12
  min = 1
  max = 52
}

local seeded: settings.IntSetting = new {
  key = "cpuMilli"
  label = "CPU"
  suggested = 300
  min = 1
  max = 64000
  requiredWhen = (scope) -> scope.config["mode"] == "CUSTOM"
  requiredCode = "REQUIRED_RESOURCE_REQUEST_MISSING"
  requiredMessage = "cpuMilli is required in CUSTOM mode"
}

local flag: settings.BoolSetting = new { key = "flag"; label = "Flag"; default = false }

local mode: settings.EnumSetting = new {
  key = "mode"
  label = "Mode"
  default = "pvc"
  options = List(
    new settings.Option { value = "pvc" },
    new settings.Option { value = "s3"; provider = "AWS" },
    new settings.Option { value = "gcs"; provider = "GCP" },
  )
  availability = List(new settings.Availability {
    accepts = (option, scope) -> option.provider == null || option.provider == scope.cluster.provider
    code = "PROVIDER_MISMATCH"
    message = (option, scope) -> "\(option.value) needs \(option.provider), got \(scope.cluster.provider)"
  })
}

local all = List(retention, seeded, flag, mode)
local function scopeOf(config: Mapping, clusterContext: Mapping?): settings.Scope =
  settings.scope(config, clusterContext, new Mapping {}, List())
local noContext = scopeOf(new Mapping {}, null)
local aws = scopeOf(new Mapping {}, new Mapping { ["mode"] = "CUSTOMER_MANAGED"; ["provider"] = "AWS" })
local custom = scopeOf(new Mapping { ["mode"] = "CUSTOM" }, null)
local pvc = scopeOf(new Mapping { ["mode"] = "pvc" }, null)

// A preset-like pair: under SMALL the CPU budget is shown read-only with the preset's values,
// under CUSTOM it is an editable required field, and AUTO shows nothing.
local cpuBudget: settings.IntSetting = (seeded) {
  key = "cpu"
  activeWhen = (scope) -> scope.config["mode"] == "CUSTOM"
  readOnlyWhen = (scope) -> scope.config["mode"] == "SMALL"
  readOnlyValue = (_) -> 100
}
local cpuLimit: settings.IntSetting = (cpuBudget) {
  key = "cpuLimit"
  suggested = null
  requiredWhen = (_) -> false
  readOnlyValue = (_) -> null
}
local budgetMode: settings.EnumSetting = (mode) {
  default = "AUTO"
  options = List("AUTO", "SMALL", "CUSTOM").map((name) -> new settings.Option { value = name })
  availability = List()
}
local budgets: evaluate.Component = new {
  label = "Demo"
  features = List(new evaluate.Feature {
    settings = List(budgetMode, cpuBudget, cpuLimit)
    rules = List()
    fragment = (scope) -> scope.config
  })
}
local function evaluateComponent(component: evaluate.Component, operation: contract.Operation, profileConfig: Mapping): contract.EvaluationResult =
  evaluate.evaluate(component, request.build(operation, profileConfig, null, new Mapping {}, List()))
local function evaluateBudgets(operation: contract.Operation, profileConfig: Mapping): contract.EvaluationResult =
  evaluateComponent(budgets, operation, profileConfig)
local contextualOperations = List(contract.resolveRequirementsOperation, contract.validateOperation, contract.compileOperation)
local small = scopeOf(new Mapping { ["mode"] = "SMALL" }, null)
local auto = scopeOf(new Mapping { ["mode"] = "AUTO" }, null)
local readOnlyCpu: contract.Field = new {
  key = "cpu"
  type = contract.numberFieldType
  required = false
  label = "CPU"
  readOnly = true
  constraints = new { min = 1; max = 64000 }
}
local alwaysReadOnly: settings.IntSetting = (cpuBudget) { readOnlyWhen = (_) -> true }
local describedBudget: settings.IntSetting = (cpuBudget) {
  description = "static"
  readOnlyDescription = (scope) -> "set by \(scope.config["mode"])"
}
local alwaysReadOnlyBudgets: evaluate.Component = (budgets) {
  features = List(new evaluate.Feature {
    settings = List(budgetMode, alwaysReadOnly)
    rules = List()
    fragment = (scope) -> scope.config
  })
}

facts {
  ["integer bounds report only the configured limits"] {
    let (lower = (retention) { min = 20; max = null })
      lower.valueViolation(19, "retentionWeeks", "Example")?.message == "Example retentionWeeks must be at least 20"
    let (upper = (retention) { min = null; max = 52 })
      upper.valueViolation(53, "retentionWeeks", "Example")?.message == "Example retentionWeeks must be at most 52"
    let (lower = (retention) { min = 20; max = null })
      lower.valueViolation(20, "retentionWeeks", "Example") == null
    let (upper = (retention) { min = null; max = 52 })
      upper.valueViolation(52, "retentionWeeks", "Example") == null
  }

  ["resolve applies defaults, keeps well-typed values and nulls ill-typed ones"] {
    settings.resolve(all, new Mapping {})
      == new Mapping { ["retentionWeeks"] = 12; ["cpuMilli"] = null; ["flag"] = false; ["mode"] = "pvc" }
    settings.resolve(all, new Mapping { ["retentionWeeks"] = 4; ["flag"] = true })["retentionWeeks"] == 4
    settings.resolve(all, new Mapping { ["retentionWeeks"] = "4" })["retentionWeeks"] == null
    settings.resolve(all, new Mapping { ["retentionWeeks"] = 4.5 })["retentionWeeks"] == null
  }

  ["a suggested value is rendered as the default but never applied"] {
    settings.field(seeded, contract.describeOperation, noContext).defaultValue == "300"
    settings.resolve(List(seeded), new Mapping {})["cpuMilli"] == null
  }

  ["the descriptor is derived from the declaration"] {
    settings.field(retention, contract.describeOperation, noContext)
      == new contract.Field {
        key = "retentionWeeks"
        type = contract.numberFieldType
        required = false
        defaultValue = "12"
        label = "Retention"
        constraints = new { min = 1; max = 52 }
      }
    settings.field(flag, contract.describeOperation, noContext).defaultValue == "false"
  }

  ["an enum lists every value without context and the available ones with a context"] {
    settings.field(mode, contract.describeOperation, noContext).constraints.allowedValues
      == List("pvc", "s3", "gcs")
    settings.field(mode, contract.describeOperation, aws).constraints.allowedValues
      == List("pvc", "s3")
  }

  ["a contextual description replaces the static one outside DESCRIBE"] {
    let (described = (flag) { description = "static"; contextualDescription = (scope) -> "on \(scope.cluster.provider)" })
      settings.field(described, contract.describeOperation, aws).description == "static"
        && settings.field(described, contract.validateOperation, aws).description == "on AWS"
  }

  ["a setting reports exactly one of: required, ill-typed, out of bounds"] {
    settings.violations(retention, contract.validateOperation, new Mapping {}, noContext, "Loki", "") == List()
    settings.violations(retention, contract.validateOperation, new Mapping { ["retentionWeeks"] = "x" }, noContext, "Loki", "")
      .map((violation) -> violation.code) == List("INVALID_TYPE")
    settings.violations(retention, contract.validateOperation, new Mapping { ["retentionWeeks"] = "x" }, noContext, "Loki", "")
      .first.message == "Loki configuration field retentionWeeks must be a whole number"
    settings.violations(retention, contract.validateOperation, new Mapping { ["retentionWeeks"] = 0 }, noContext, "Loki", "")
      .first.message == "Loki retentionWeeks must be between 1 and 52"
    settings.violations(mode, contract.validateOperation, new Mapping { ["mode"] = "nfs" }, noContext, "Loki", "")
      .first.code == "VALUE_NOT_ALLOWED"
  }

  ["a conditionally required setting is reported only when saving or compiling"] {
    settings.violations(seeded, contract.validateOperation, new Mapping {}, custom, "Loki", "")
      == List(new contract.Violation {
        code = "REQUIRED_RESOURCE_REQUEST_MISSING"
        fieldPath = "cpuMilli"
        message = "cpuMilli is required in CUSTOM mode"
      })
    settings.violations(seeded, contract.resolveRequirementsOperation, new Mapping {}, custom, "Loki", "") == List()
    settings.violations(seeded, contract.compileOperation, new Mapping {}, pvc, "Loki", "") == List()
  }

  ["availability narrows, gates and reports the selected option"] {
    mode.available(mode.option("s3") as settings.Option, aws)
    !mode.available(mode.option("gcs") as settings.Option, aws)
    mode.availabilityViolations(mode.option("gcs") as settings.Option, aws)
      == List(new contract.Violation {
        code = "PROVIDER_MISMATCH"
        fieldPath = "mode"
        message = "gcs needs GCP, got AWS"
      })
    mode.option("nfs") == null
  }
  ["cluster version reaches rules without inventing a default or coercing non-string context"] {
    settings.context(null).kubernetesVersion == null
    settings.context(new Mapping {}).kubernetesVersion == null
    for (value in List(null, 1.34, false, new Listing {})) {
      settings.context(new Mapping { ["kubernetesVersion"] = value }).kubernetesVersion == null
    }
    scopeOf(new Mapping {}, new Mapping { ["kubernetesVersion"] = "1.34" }).cluster.kubernetesVersion == "1.34"
    // Interpretation of supported versions belongs to each component, not the generic SDK.
    settings.context(new Mapping { ["kubernetesVersion"] = "custom-version" }).kubernetesVersion == "custom-version"
  }

  ["a read-only setting is listed only outside DESCRIBE, while inactive, without default or requirement"] {
    settings.field(cpuBudget, contract.describeOperation, small).readOnly == null
    settings.field(cpuBudget, contract.describeOperation, small).defaultValue == "300"
    for (operation in contextualOperations) {
      settings.fields(List(cpuBudget), operation, small, false) == List(readOnlyCpu)
      settings.fields(List((cpuBudget) { required = true }), operation, small, false) == List(readOnlyCpu)
      settings.fields(List(cpuBudget), operation, auto, false).isEmpty
      settings.fields(List(cpuBudget), operation, custom, false).single.readOnly == null
      settings.fields(List(cpuBudget), operation, custom, false).single.required
    }
    evaluateBudgets(contract.describeOperation, new Mapping { ["mode"] = "SMALL" }).resolvedValues == null
    evaluateBudgets(contract.resolveRequirementsOperation, new Mapping { ["mode"] = "AUTO" }).resolvedValues == null
  }

  ["an active setting stays editable and validated while its read-only condition holds"] {
    for (operation in contextualOperations) {
      settings.field(alwaysReadOnly, operation, custom).readOnly == null
      settings.field(alwaysReadOnly, operation, custom).required
    }
    evaluateComponent(alwaysReadOnlyBudgets, contract.resolveRequirementsOperation, new Mapping { ["mode"] = "CUSTOM" })
      .resolvedValues == null
    evaluateComponent(alwaysReadOnlyBudgets, contract.validateOperation, new Mapping { ["mode"] = "CUSTOM" })
      .violations
      .map((violation) -> violation.code)
      == List("REQUIRED_RESOURCE_REQUEST_MISSING")
  }

  ["a read-only description replaces the description only while the field is read-only"] {
    for (operation in contextualOperations) {
      settings.field(describedBudget, operation, small).description == "set by SMALL"
      settings.field(describedBudget, operation, custom).description == "static"
      settings.field((describedBudget) { readOnlyDescription = null }, operation, small).description == "static"
    }
    settings.field(describedBudget, contract.describeOperation, small).description == "static"
  }

  ["a resolved value is string-encoded and a null one is rendered as its key alone"] {
    let (renderer = new JsonRenderer {})
      renderer.renderValue(evaluateBudgets(contract.resolveRequirementsOperation, new Mapping { ["mode"] = "SMALL" }).resolvedValues)
        == renderer.renderValue(
          new Listing {
            new Mapping { ["key"] = "cpu"; ["value"] = "100" }
            new Mapping { ["key"] = "cpuLimit" }
          },
        )
  }

  ["a value sent back for a read-only key is stored but neither validated nor compiled"] {
    for (operation in List(contract.validateOperation, contract.compileOperation)) {
      let (result = evaluateBudgets(operation, new Mapping { ["mode"] = "SMALL"; ["cpu"] = 999999; ["cpuLimit"] = "x" }))
        result.violations.isEmpty
          && result.resolvedValues!!.map((entry) -> entry.value) == List("100", null)
          && result.helmValues == (if (operation == contract.compileOperation) new Mapping { ["mode"] = "SMALL" } else null)
    }
  }

  ["only a top-level, non-sensitive setting with a typed value can be read-only"] {
    module.catch(() -> new settings.ObjectSetting { key = "group"; label = "Group"; fields = List(cpuBudget) }.fields)
      .contains("read-only condition")
    module.catch(() -> (cpuBudget) { readOnlyValue = null }.readOnlyWhen).contains("Type constraint")
    module.catch(() -> settings.field((cpuBudget) { sensitive = true }, contract.validateOperation, small).readOnly)
      .contains("!sensitive")
    module.catch(() -> settings.resolvedValue((cpuBudget) { readOnlyValue = (_) -> "100m" }, small).value)
      .contains("Read-only value of cpu must be a whole number")
  }
}
