@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.certManagerConfigs.configuration.setting

import "../sdk/settings.pkl" as sdkSettings
import "profile.pkl"

settings: List<sdkSettings.Setting> = List(
  new sdkSettings.EnumSetting {
    key = profile.existingSecretNameKey
    required = false
    default = ""
    label = "Existing TLS Secret"
    description = "Leave empty to let Qovery issue the Let's Encrypt certificate of the cluster domain. Select \(profile.gatewayCertificateSecretName) only if you created your own kubernetes.io/tls Secret with this name in the cert-manager namespace."
    options = List("", profile.gatewayCertificateSecretName).map((choice) -> new sdkSettings.Option { value = choice })
  },
)
