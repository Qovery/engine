@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.karpenterQoveryConfiguration.settings

import "pools/dependencies.pkl" as poolsDependencies
import "pools/helm.pkl" as poolsHelm
import "pools/inputs.pkl" as poolsInputs
import "pools/setting.pkl" as poolsSetting
import "sdk/evaluate.pkl" as sdkEvaluate
import "sdk/referenceData.pkl" as sdkReferenceData

function component(request: Mapping): sdkEvaluate.Component =
  let (instances = sdkReferenceData.computeInstances(request))
    new {
      label = "Qovery Karpenter pools"
      inputs = poolsInputs.inputs
      features =
        List(new sdkEvaluate.Feature {
          settings = poolsSetting.settings(instances ?? List())
          rules = poolsDependencies.rules + List(sdkReferenceData.required(instances))
          fragment = poolsHelm.fragment
        })
    }
