@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.clusterAgent.evaluation

import "compile.pkl"
import "contract.pkl"
import "sdk/request.pkl" as sdkRequest
import "sdk/result.pkl" as sdkResult

// Pure orchestration entrypoint shared by model.pkl and the native Pkl tests.
function evaluate(request: Mapping): contract.EvaluationResult =
  sdkResult.envelope(
    sdkRequest.operation(request),
    List(),
    List(),
    List(),
    () -> compile.compile(sdkRequest.enabledComponents(request).contains("loki")),
  )
