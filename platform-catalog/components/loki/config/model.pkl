@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.loki.model

import "pkl:json"

import "catalog.pkl"
import "helm.pkl"
import "validation.pkl"

// This is the only entrypoint known by q-core. It deliberately contains orchestration only:
// 1. decode the language-neutral request supplied through prop:request;
// 2. delegate catalogue, requirement, validation and Helm concerns to focused modules;
// 3. render the language-neutral response as JSON.
local request = (new json.Parser { useMapping = true }).parse(read("prop:request")) as Mapping
local operation = request["operation"] as String
local profileConfig = request["profileConfig"] as Mapping
local clusterContext = request["clusterContext"] as Mapping?
local clusterInputs = request["clusterInputs"] as Mapping

local computedViolations =
  validation.violations(operation, profileConfig, clusterContext, clusterInputs)

fields = catalog.fields
requiredInputs = validation.requiredInputs(operation, profileConfig, clusterContext)
violations = computedViolations

// Invalid inputs never produce partial Helm values. q-core treats a missing helmValues on a valid
// COMPILE request as a hard error, so this remains fail-closed on both sides of the contract.
helmValues =
  if (operation == "COMPILE" && computedViolations.isEmpty)
    helm.compile(profileConfig, clusterInputs)
  else
    null

output {
  value = new Mapping {
    ["fields"] = fields
    ["requiredInputs"] = requiredInputs
    ["violations"] = violations
    ["helmValues"] = helmValues
  }
  renderer = new JsonRenderer {}
}
