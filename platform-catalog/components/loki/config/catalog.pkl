@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.loki.catalog

import "contract.pkl"

// Keep the typed product defaults and constraints next to the metadata rendered to the Console.
// profile.pkl and validation.pkl reuse these values so changing the catalogue cannot silently
// change only one side of the contract.
retentionWeeksDefault: Int = 12
retentionWeeksMin: Int = 1
retentionWeeksMax: Int = 52
highAvailabilityDefault: Boolean = false
storageDefault: String = "pvc"
storageAllowedValues: List<String> = List("pvc", "s3")

s3BucketInput: contract.LogicalInput = new contract.LogicalInput {
  key = "infra.s3BucketName"
  type = "s3BucketName"
  scope = "CLUSTER"
  label = "S3 bucket name"
  description = "Bucket used by Loki for chunks, ruler and admin data."
  constraints = new {
    pattern =
      "^(?!(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$)(?=[a-z0-9.-]{3,63}$)[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$"
  }
}

s3RoleInput: contract.LogicalInput = new contract.LogicalInput {
  key = "infra.lokiRoleArn"
  type = "awsIamRoleArn"
  scope = "CLUSTER"
  label = "Loki IAM role ARN"
  description = "IAM role assumed by Loki through IRSA."
  constraints = new { pattern = "^arn:aws[a-z-]*:iam::[0-9]{12}:role/[A-Za-z0-9_+=,.@/-]+$" }
}

// Static form metadata. Adding a field here does not require Loki-specific UI code.
fields: List<contract.Field> =
  List(
    new contract.Field {
      key = "retentionWeeks"
      type = "number"
      required = false
      defaultValue = "\(retentionWeeksDefault)"
      label = "Retention period"
      description = "Whole number of weeks to retain Loki logs."
      constraints = new { min = retentionWeeksMin; max = retentionWeeksMax }
    },
    new contract.Field {
      key = "highAvailability"
      type = "bool"
      required = false
      defaultValue = "\(highAvailabilityDefault)"
      label = "High availability"
      description = "Uses Loki simple-scalable mode and requires S3 storage."
    },
    new contract.Field {
      key = "storage"
      type = "string"
      required = false
      defaultValue = storageDefault
      label = "Storage"
      description = "Storage backend used by Loki."
      constraints = new { allowedValues = storageAllowedValues }
    },
  )

// Logical requirements are separate from their concrete source. q-core decides whether a
// value comes from the customer, Terraform output, or another trusted runtime source.
s3Inputs: List<contract.LogicalInput> = List(s3BucketInput, s3RoleInput)

// Used to reject misspelled or obsolete fields instead of silently ignoring them.
fieldKeys: Set<String> = fields.map((field) -> field.key).toSet()
