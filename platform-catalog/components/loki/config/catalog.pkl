@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.loki.catalog

import "contract.pkl"

// Keep the typed product defaults and constraints next to the metadata rendered to the Console.
// profile.pkl and validation.pkl reuse these values so changing the catalogue cannot silently
// change only one side of the contract.
retentionWeeksDefault: Int = 12
retentionWeeksMin: Int = 1
retentionWeeksMax: Int = 52
highAvailabilityDefault: Boolean = false
storageDefault: String = "pvc"
storageAllowedValues: List<String> =
  List("pvc", "s3", "gcs", "azureBlob", "s3Compatible")

local dnsCompatibleBucketPattern: String =
  "^(?!(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$)(?=[a-z0-9.-]{3,63}$)[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$"

s3BucketInput: contract.LogicalInput = new contract.LogicalInput {
  key = "infra.s3BucketName"
  type = "s3BucketName"
  scope = "CLUSTER"
  label = "S3 bucket name"
  description = "Bucket used by Loki for chunks, ruler and admin data."
  constraints = new { pattern = dnsCompatibleBucketPattern }
}

s3RoleInput: contract.LogicalInput = new contract.LogicalInput {
  key = "infra.lokiRoleArn"
  type = "awsIamRoleArn"
  scope = "CLUSTER"
  label = "Loki IAM role ARN"
  description = "IAM role assumed by Loki through IRSA."
  constraints = new { pattern = "^arn:aws[a-z-]*:iam::[0-9]{12}:role/[A-Za-z0-9_+=,.@/-]+$" }
}

gcsBucketInput: contract.LogicalInput = new contract.LogicalInput {
  key = "infra.gcsBucketName"
  type = "gcsBucketName"
  scope = "CLUSTER"
  label = "GCS bucket name"
  description = "Google Cloud Storage bucket used by Loki for chunks, ruler and admin data."
  constraints = new {
    // Deliberately use the DNS-compatible subset accepted by GCS.
    pattern = dnsCompatibleBucketPattern
  }
}

gcpServiceAccountInput: contract.LogicalInput = new contract.LogicalInput {
  key = "infra.gcpServiceAccountEmail"
  type = "gcpServiceAccountEmail"
  scope = "CLUSTER"
  label = "GCP service account email"
  description = "Service account bound to the Loki Kubernetes service account through Workload Identity."
  constraints = new { pattern = "^[^@\\s]+@[^@\\s]+\\.iam\\.gserviceaccount\\.com$" }
}

azureStorageAccountInput: contract.LogicalInput = new contract.LogicalInput {
  key = "infra.azureStorageAccountName"
  type = "azureStorageAccountName"
  scope = "CLUSTER"
  label = "Azure storage account"
  description = "Storage account containing the Loki Blob Storage container."
  constraints = new { pattern = "^[a-z0-9]{3,24}$" }
}

azureContainerInput: contract.LogicalInput = new contract.LogicalInput {
  key = "infra.azureContainerName"
  type = "azureBlobContainerName"
  scope = "CLUSTER"
  label = "Azure Blob container"
  description = "Blob Storage container used by Loki for chunks, ruler and admin data."
  constraints = new { pattern = "^(?!.*--)[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$" }
}

azureManagedIdentityInput: contract.LogicalInput = new contract.LogicalInput {
  key = "infra.azureManagedIdentityClientId"
  type = "uuid"
  scope = "CLUSTER"
  label = "Azure managed identity client ID"
  description = "Managed identity used by Loki through Azure Workload Identity."
  constraints = new {
    pattern = "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
  }
}

s3CompatibleBucketInput: contract.LogicalInput = new contract.LogicalInput {
  key = "infra.s3CompatibleBucketName"
  type = "s3BucketName"
  scope = "CLUSTER"
  label = "S3-compatible bucket name"
  description = "S3-compatible bucket used by Loki for chunks, ruler and admin data."
  constraints = new { pattern = dnsCompatibleBucketPattern }
}

s3CompatibleEndpointInput: contract.LogicalInput = new contract.LogicalInput {
  key = "infra.s3CompatibleEndpoint"
  type = "httpsUrl"
  scope = "CLUSTER"
  label = "S3-compatible endpoint"
  description = "HTTPS endpoint of the S3-compatible object store, without credentials."
  constraints = new {
    pattern = "^https://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?/?$"
  }
}

s3CompatibleRegionInput: contract.LogicalInput = new contract.LogicalInput {
  key = "infra.s3CompatibleRegion"
  type = "cloudRegion"
  scope = "CLUSTER"
  label = "S3-compatible region"
  description = "Region expected by the S3-compatible object store."
  constraints = new { pattern = "^[a-z0-9][a-z0-9-]{1,62}$" }
}

s3CompatibleCredentialsSecretInput: contract.LogicalInput = new contract.LogicalInput {
  key = "infra.s3CompatibleCredentialsSecretName"
  type = "kubernetesSecretName"
  scope = "CLUSTER"
  label = "S3-compatible credentials Secret"
  description =
    "Name of a Secret in the Loki namespace containing S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY. The credentials never enter q-core."
  constraints = new {
    pattern =
      "^(?=.{1,253}$)[a-z0-9](?:[-a-z0-9]*[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)*$"
  }
}

// DESCRIBE exposes the component's complete capabilities for catalog browsing. Operations carrying
// cluster context return the effective storage choices so the generic Console form never needs
// Loki/provider conditionals of its own.
fields: List<contract.Field> = fieldsWithStorageAllowedValues(storageAllowedValues)

function fieldsForContext(
  operation: String,
  clusterContext: Mapping?,
): List<contract.Field> =
  fieldsWithStorageAllowedValues(effectiveStorageAllowedValues(operation, clusterContext))

local function effectiveStorageAllowedValues(
  operation: String,
  clusterContext: Mapping?,
): List<String> =
  let (mode = clusterContext?.getOrNull("mode") as String?)
  let (provider = clusterContext?.getOrNull("provider") as String?)
    if (clusterContext == null)
      storageAllowedValues
    else if (mode == "QOVERY_MANAGED")
      List("pvc")
    else if (provider == "AWS")
      List("pvc", "s3")
    else if (provider == "GCP")
      List("pvc", "gcs")
    else if (provider == "AZURE")
      List("pvc", "azureBlob")
    else if (provider == "SCW")
      List("pvc", "s3Compatible")
    else
      List("pvc")

local function fieldsWithStorageAllowedValues(
  effectiveStorageValues: List<String>,
): List<contract.Field> =
  List(
    new contract.Field {
      key = "retentionWeeks"
      type = "number"
      required = false
      defaultValue = "\(retentionWeeksDefault)"
      label = "Retention period"
      description = "Whole number of weeks to retain Loki logs."
      constraints = new { min = retentionWeeksMin; max = retentionWeeksMax }
    },
    new contract.Field {
      key = "highAvailability"
      type = "bool"
      required = false
      defaultValue = "\(highAvailabilityDefault)"
      label = "High availability"
      description = "Uses Loki simple-scalable mode and requires object storage."
    },
    new contract.Field {
      key = "storage"
      type = "string"
      required = false
      defaultValue = storageDefault
      label = "Storage"
      description = "Storage backend used by Loki."
      constraints = new { allowedValues = effectiveStorageValues }
    },
  )

// Logical requirements are separate from their concrete source. q-core decides whether a
// value comes from the customer, Terraform output, or another trusted runtime source.
s3Inputs: List<contract.LogicalInput> = List(s3BucketInput, s3RoleInput)
gcsInputs: List<contract.LogicalInput> = List(gcsBucketInput, gcpServiceAccountInput)
azureBlobInputs: List<contract.LogicalInput> =
  List(azureStorageAccountInput, azureContainerInput, azureManagedIdentityInput)
s3CompatibleInputs: List<contract.LogicalInput> =
  List(
    s3CompatibleBucketInput,
    s3CompatibleEndpointInput,
    s3CompatibleRegionInput,
    s3CompatibleCredentialsSecretInput,
  )

function inputsForStorage(storage: String?): List<contract.LogicalInput> =
  if (storage == "s3")
    s3Inputs
  else if (storage == "gcs")
    gcsInputs
  else if (storage == "azureBlob")
    azureBlobInputs
  else if (storage == "s3Compatible")
    s3CompatibleInputs
  else
    List()

// Used to reject misspelled or obsolete fields instead of silently ignoring them.
fieldKeys: Set<String> = fields.map((field) -> field.key).toSet()
