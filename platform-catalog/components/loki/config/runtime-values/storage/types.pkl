@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.loki.storage.types

import "../context.pkl"
import "../contract.pkl"

// Shared storage types. Product metadata belongs in backends.pkl and logical input metadata belongs
// in inputs.pkl, keeping this module deliberately free of provider-specific values.
open class StorageBackend {
  key: String
  provider: context.SupportedProvider? = null
  customerInputs: List<contract.LogicalInput> = List()
  compileOnlyInputs: Mapping<String, CompileInput> = new {}
}

// Internal values supplied by q-core only at compile time. Unlike LogicalInput, these declarations
// are never exposed as customer-editable fields in the Console.
class CompileInput {
  key: String
}

class ObjectStorageBackend extends StorageBackend {
  provider: context.SupportedProvider
  objectStoreId: String
  bucketInput: contract.LogicalInput
}
