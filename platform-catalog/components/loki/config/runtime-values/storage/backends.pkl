@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.loki.storage.backends

import "../context.pkl"
import "../contract.pkl"
import "inputs.pkl"
import "types.pkl"

// One typed registry owns the product-facing storage matrix. Describe, requirements, validation,
// and compilation all consume it, so adding a backend cannot update only one of those paths.
pvc: types.StorageBackend = new {
  key = "pvc"
}

s3: types.ObjectStorageBackend = new {
  key = "s3"
  provider = context.awsProvider
  objectStoreId = "s3"
  bucketInput = inputs.s3Bucket
  customerInputs = List(inputs.s3Bucket, inputs.s3Role)
  compileOnlyInputs = new {
    ["region"] = inputs.awsRegion
  }
}

gcs: types.ObjectStorageBackend = new {
  key = "gcs"
  provider = context.gcpProvider
  objectStoreId = "gcs"
  bucketInput = inputs.gcsBucket
  customerInputs = List(inputs.gcsBucket, inputs.gcpServiceAccount)
}

azureBlob: types.ObjectStorageBackend = new {
  key = "azureBlob"
  provider = context.azureProvider
  objectStoreId = "azure"
  bucketInput = inputs.azureContainer
  customerInputs =
    List(
      inputs.azureStorageAccount,
      inputs.azureContainer,
      inputs.azureManagedIdentity,
    )
}

s3Compatible: types.ObjectStorageBackend = new {
  key = "s3Compatible"
  provider = context.scalewayProvider
  objectStoreId = "s3"
  bucketInput = inputs.s3CompatibleBucket
  customerInputs =
    List(
      inputs.s3CompatibleBucket,
      inputs.s3CompatibleEndpoint,
      inputs.s3CompatibleRegion,
      inputs.s3CompatibleCredentialsSecret,
    )
}

backends: Mapping<String, types.StorageBackend> = new {
  [pvc.key] = pvc
  [s3.key] = s3
  [gcs.key] = gcs
  [azureBlob.key] = azureBlob
  [s3Compatible.key] = s3Compatible
}

allowedValues: List<String> = backends.keys.toList()

// Provider-neutral default: a fresh configuration keeps the chart's persistent-volume storage.
// Owned here rather than in describe.pkl so the draft reader resolves it without the Console layer.
defaultKey: String = pvc.key

function find(key: String?): types.StorageBackend? =
  if (key == null) null else backends.getOrNull(key)

// A backend is usable on a cluster when it is provider-neutral or matches the cluster provider.
// An unknown key never matches: the caller reports it as a value violation instead.
function matchesProvider(backend: types.StorageBackend?, provider: String?): Boolean =
  backend != null && (backend.provider == null || backend.provider == provider)

// `provider` stays an open String so clusters on providers without object-storage support still
// see the provider-neutral pvc choice.
function allowedValuesForContext(mode: context.ClusterMode?, provider: String?): List<String> =
  if (mode == context.qoveryManagedMode)
    List(pvc.key)
  else
    backends.keys
      .filter((key) -> backends[key].provider == null || backends[key].provider == provider)
      .toList()
