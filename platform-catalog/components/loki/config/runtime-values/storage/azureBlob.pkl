@ModuleInfo { minPklVersion = "0.32.0" }
amends "backend.pkl"

import "../contract.pkl"

// Azure Blob Storage through Azure Workload Identity: the identity is selected by pod label and
// bound through the service account annotation.
local storageAccount: contract.LogicalInput = new {
  key = "infra.azureStorageAccountName"
  type = contract.stringFieldType
  scope = contract.clusterScope
  label = "Azure storage account"
  description = "Storage account containing the Loki Blob Storage container."
  constraints = new { pattern = "^[a-z0-9]{3,24}$" }
}

local managedIdentity: contract.LogicalInput = new {
  key = "infra.azureManagedIdentityClientId"
  type = contract.stringFieldType
  scope = contract.clusterScope
  label = "Azure managed identity client ID"
  description = "Managed identity used by Loki through Azure Workload Identity."
  constraints = new {
    pattern = "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
  }
}

option {
  value = "azureBlob"
  provider = "AZURE"
  inputs = List(storageAccount, bucket, managedIdentity)
}

objectStoreId = "azure"

bucket = new {
  key = "infra.azureContainerName"
  type = contract.stringFieldType
  scope = contract.clusterScope
  label = "Azure Blob container"
  description = "Blob Storage container used by Loki for chunks, ruler and admin data."
  constraints = new { pattern = "^(?!.*--)[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$" }
}

storageConfig = (scope) -> Pair("azure", new Mapping {
  ["accountName"] = scope.inputs[storageAccount.key]
  ["useManagedIdentity"] = false
  ["useFederatedToken"] = true
})

serviceAccount = (scope) -> new Mapping {
  ["name"] = "qovery-storage"
  ["labels"] = new Mapping { ["azure.workload.identity/use"] = "true" }
  ["annotations"] = new Mapping { ["azure.workload.identity/client-id"] = scope.inputs[managedIdentity.key] }
}

podLabels = new Mapping { ["azure.workload.identity/use"] = "true" }
