@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.loki.storage.helm

import "../contract.pkl"
import "../sdk/helm.pkl" as sdkHelm
import "../sdk/settings.pkl" as sdkSettings
import "backend.pkl"
import "setting.pkl"

// The chart values owned by the storage choice: the `loki.storage` block and its schema, the
// identity wiring, and the persistence of each workload. Object storage is durable, so local
// volumes only hold ephemeral state: the chart's PVCs are disabled and the single binary mounts
// an explicit emptyDir because the container root filesystem is read-only.
fragment: sdkHelm.Fragment = (scope) ->
  let (selected = setting.selected(scope))
  let (serviceAccount = selected.serviceAccount.apply(scope))
    new Mapping {
      ["loki"] = lokiValues(selected, scope)
      ["singleBinary"] = selected.decorateTarget.apply(singleBinaryValues(selected), scope)
      ["write"] = selected.decorateTarget.apply(statefulValues(selected), scope)
      ["read"] = selected.decorateTarget.apply(new Mapping {}, scope)
      ["backend"] = selected.decorateTarget.apply(statefulValues(selected), scope)
      when (serviceAccount != null) {
        ["serviceAccount"] = serviceAccount
      }
    }

local function lokiValues(selected: backend, scope: sdkSettings.Scope): Mapping = new Mapping {
  when (selected.podLabels != null) {
    ["podLabels"] = selected.podLabels
  }
  when (selected.isObjectStorage) {
    ["storage"] = objectStorageValues(selected, scope)
    ["schemaConfig"] = new Mapping {
      // Initial schema for fresh Engine v2 installations. Changing storage on an existing Loki
      // requires appending a future-dated period instead of rewriting this one.
      ["configs"] = List(new Mapping {
        ["from"] = "2024-04-01"
        ["store"] = "tsdb"
        ["object_store"] = selected.objectStoreId
        ["schema"] = "v13"
        ["index"] = new Mapping { ["prefix"] = "index_"; ["period"] = "24h" }
      })
    }
    ["compactor"] = new Mapping { ["delete_request_store"] = selected.objectStoreId }
  }
}

local function objectStorageValues(selected: backend, scope: sdkSettings.Scope): Mapping =
  let (bucket = scope.inputs[(selected.bucket as contract.LogicalInput).key])
  let (providerConfig = selected.storageConfig.apply(scope))
    new Mapping {
      ["type"] = selected.objectStoreId
      ["bucketNames"] = new Mapping {
        ["chunks"] = bucket
        ["ruler"] = bucket
        ["admin"] = bucket
      }
      when (providerConfig != null) {
        [providerConfig.first] = providerConfig.second
      }
    }

local function singleBinaryValues(selected: backend): Mapping = new Mapping {
  when (selected.isObjectStorage) {
    ["persistence"] = new Mapping { ["enabled"] = false }
    ["extraVolumes"] = List(new Mapping { ["name"] = "storage"; ["emptyDir"] = new Mapping {} })
    ["extraVolumeMounts"] = List(new Mapping { ["name"] = "storage"; ["mountPath"] = "/var/loki" })
  }
}

// The chart enables write/backend volume claims by default; with object storage they only hold
// ephemeral state.
local function statefulValues(selected: backend): Mapping = new Mapping {
  when (selected.isObjectStorage) {
    ["persistence"] = new Mapping { ["volumeClaimsEnabled"] = false }
  }
}
