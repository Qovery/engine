@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.loki.storage.helm

import "../profile.pkl"
import "backends.pkl" as storageBackends
import "inputs.pkl" as storageInputs
import "types.pkl" as storage

// Contains chart-specific adaptation for object storage. Product capability, provider, and input
// declarations stay under storage/; the high-level topology stays in compile.pkl.
function serviceAccountValues(backend: storage.StorageBackend, clusterInputs: Mapping): Mapping? =
  if (backend.key == storageBackends.s3.key)
    new Mapping {
      ["annotations"] = new Mapping {
        ["eks.amazonaws.com/role-arn"] = clusterInputs[storageInputs.s3Role.key]
      }
    }
  else if (backend.key == storageBackends.gcs.key)
    new Mapping {
      ["annotations"] = new Mapping {
        ["iam.gke.io/gcp-service-account"] = clusterInputs[storageInputs.gcpServiceAccount.key]
      }
    }
  else if (backend.key == storageBackends.azureBlob.key)
    new Mapping {
      ["name"] = "qovery-storage"
      ["labels"] = new Mapping { ["azure.workload.identity/use"] = "true" }
      ["annotations"] = new Mapping {
        ["azure.workload.identity/client-id"] =
          clusterInputs[storageInputs.azureManagedIdentity.key]
      }
    }
  else
    null

function decorateTarget(
  targetValues: Mapping,
  backend: storage.StorageBackend,
  clusterInputs: Mapping,
): Mapping =
  if (backend.key == storageBackends.s3Compatible.key)
    (targetValues) {
      ["extraArgs"] = List("-config.expand-env=true")
      ["extraEnvFrom"] = s3CompatibleCredentialsEnvFrom(clusterInputs)
    }
  else
    targetValues

// Only the Secret name enters values.final.yaml. The Secret itself is created by the customer in
// the Loki namespace and contains S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY.
local function s3CompatibleCredentialsEnvFrom(clusterInputs: Mapping): List<Mapping> =
  List(new Mapping {
    ["secretRef"] = new Mapping {
      ["name"] = clusterInputs[storageInputs.s3CompatibleCredentialsSecret.key]
    }
  })

function lokiValues(
  profileConfig: Mapping,
  clusterInputs: Mapping,
  backend: storage.StorageBackend,
  replicationFactor: Int,
): Mapping = new Mapping {
  ["commonConfig"] = new Mapping { ["replication_factor"] = replicationFactor }
  ["limits_config"] = new Mapping {
    // Loki expects a duration; the product model intentionally exposes easier-to-understand weeks.
    // COMPILE is called only after validation, so a null here is an invariant failure, not a default.
    ["retention_period"] = "\((profile.retentionWeeks(profileConfig) as Int) * 168)h"
  }
  when (backend.key == storageBackends.azureBlob.key) {
    ["podLabels"] = new Mapping { ["azure.workload.identity/use"] = "true" }
  }
  when (backend is storage.ObjectStorageBackend) {
    ["storage"] = objectStorageValues(backend, clusterInputs)
    ["schemaConfig"] = new Mapping {
      // Initial schema for fresh Engine v2 installations. Changing storage on an existing Loki
      // requires appending a future-dated period instead of rewriting this one.
      ["configs"] =
        List(new Mapping {
          ["from"] = "2024-04-01"
          ["store"] = "tsdb"
          ["object_store"] = backend.objectStoreId
          ["schema"] = "v13"
          ["index"] = new Mapping { ["prefix"] = "index_"; ["period"] = "24h" }
        })
    }
    ["compactor"] = new Mapping { ["delete_request_store"] = backend.objectStoreId }
  }
}

local function objectStorageValues(
  backend: storage.ObjectStorageBackend,
  clusterInputs: Mapping,
): Mapping =
  let (bucket = clusterInputs[backend.bucketInput.key])
    new Mapping {
      ["type"] = backend.objectStoreId
      ["bucketNames"] = new Mapping {
        ["chunks"] = bucket
        ["ruler"] = bucket
        ["admin"] = bucket
      }
      when (backend.key == storageBackends.s3.key) {
        ["s3"] = new Mapping { ["region"] = clusterInputs["infra.awsRegion"] }
      }
      when (backend.key == storageBackends.gcs.key) {
        ["gcs"] = new Mapping {
          ["chunkBufferSize"] = 0
          ["requestTimeout"] = "0s"
          ["enableHttp2"] = true
        }
      }
      when (backend.key == storageBackends.azureBlob.key) {
        ["azure"] = new Mapping {
          ["accountName"] = clusterInputs[storageInputs.azureStorageAccount.key]
          ["useManagedIdentity"] = false
          ["useFederatedToken"] = true
        }
      }
      when (backend.key == storageBackends.s3Compatible.key) {
        ["s3"] = new Mapping {
          ["endpoint"] = clusterInputs[storageInputs.s3CompatibleEndpoint.key]
          ["region"] = clusterInputs[storageInputs.s3CompatibleRegion.key]
          ["accessKeyId"] = "${S3_ACCESS_KEY_ID}"
          ["secretAccessKey"] = "${S3_SECRET_ACCESS_KEY}"
          ["signatureVersion"] = "v4"
          ["s3ForcePathStyle"] = true
          ["insecure"] = false
        }
      }
    }
