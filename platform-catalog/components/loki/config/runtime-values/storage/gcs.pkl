@ModuleInfo { minPklVersion = "0.32.0" }
amends "backend.pkl"

import "../contract.pkl"
import "patterns.pkl"

// Google Cloud Storage through Workload Identity.
local serviceAccountEmail: contract.LogicalInput = new {
  key = "infra.gcpServiceAccountEmail"
  type = contract.stringFieldType
  scope = contract.clusterScope
  label = "GCP service account email"
  description =
    "Service account bound to the Loki Kubernetes service account through Workload Identity."
  constraints = new { pattern = "^[^@\\s]+@[^@\\s]+\\.iam\\.gserviceaccount\\.com$" }
}

option {
  value = "gcs"
  provider = "GCP"
  inputs = List(bucket, serviceAccountEmail)
}

objectStoreId = "gcs"

bucket = new {
  key = "infra.gcsBucketName"
  type = contract.stringFieldType
  scope = contract.clusterScope
  label = "GCS bucket name"
  description = "Google Cloud Storage bucket used by Loki for chunks, ruler and admin data."
  // Deliberately the DNS-compatible subset accepted by GCS.
  constraints = new { pattern = patterns.dnsCompatibleBucket }
}

storageConfig = (_) -> Pair("gcs", new Mapping {
  ["chunkBufferSize"] = 0
  ["requestTimeout"] = "0s"
  ["enableHttp2"] = true
})

serviceAccount = (scope) -> new Mapping {
  ["annotations"] = new Mapping { ["iam.gke.io/gcp-service-account"] = scope.inputs[serviceAccountEmail.key] }
}
