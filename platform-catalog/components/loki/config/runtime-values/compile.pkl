@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.loki.compile

import "profile.pkl"
import "resources/helm.pkl" as resourcesHelm
import "resources/targets.pkl" as resourcesTargets
import "storage/backends.pkl" as storageBackends
import "storage/helm.pkl" as storageHelm
import "storage/types.pkl" as storageTypes

// Produces Source 3 only: the Loki values derived from customer-facing product settings.
// q-core merges this after chart defaults and context overlays.
// COMPILE runs only on a validated configuration, so every narrowing below is an invariant, not a
// default. Resolving the draft here is what lets the feature packages take plain values.
function compile(profileConfig: Mapping, clusterInputs: Mapping): Mapping =
  let (storageKey = profile.storage(profileConfig) as String)
  let (backend = storageBackends.find(storageKey) as storageTypes.StorageBackend)
  let (isObjectStorage = backend is storageTypes.ObjectStorageBackend)
  let (isHighAvailability = profile.highAvailability(profileConfig) == true)
  let (retentionWeeks = profile.retentionWeeks(profileConfig) as Int)
  let (resourceProfileName = profile.resourceProfile(profileConfig) as String)
  let (scalableReplicas = if (isHighAvailability) 3 else 0)
  let (replicationFactor = if (isHighAvailability) scalableReplicas else 1)
  let (serviceAccount = storageHelm.serviceAccountValues(backend, clusterInputs))
    new Mapping {
      ["deploymentMode"] = if (isHighAvailability) "SimpleScalable" else "SingleBinary"
      ["loki"] = storageHelm.lokiValues(retentionWeeks, clusterInputs, backend, replicationFactor)
      ["singleBinary"] =
        withResources(
          singleBinaryValues(isHighAvailability, isObjectStorage, backend, clusterInputs),
          resourcesHelm.targetResources(profileConfig, resourceProfileName, resourcesTargets.singleBinary, isHighAvailability),
        )
      ["write"] =
        withResources(
          scalableStatefulTargetValues(scalableReplicas, isObjectStorage, backend, clusterInputs),
          resourcesHelm.targetResources(profileConfig, resourceProfileName, resourcesTargets.write, isHighAvailability),
        )
      ["read"] =
        withResources(
          readTargetValues(scalableReplicas, backend, clusterInputs),
          resourcesHelm.targetResources(profileConfig, resourceProfileName, resourcesTargets.`read`, isHighAvailability),
        )
      ["backend"] =
        withResources(
          scalableStatefulTargetValues(
            scalableReplicas,
            isObjectStorage,
            backend,
            clusterInputs,
          ),
          resourcesHelm.targetResources(profileConfig, resourceProfileName, resourcesTargets.backend, isHighAvailability),
        )
      when (isHighAvailability) {
        ["gateway"] =
          withResources(
            new Mapping { ["replicas"] = scalableReplicas },
            resourcesHelm.targetResources(profileConfig, resourceProfileName, resourcesTargets.gateway, isHighAvailability),
          )
      }
      when (serviceAccount != null) {
        ["serviceAccount"] = serviceAccount
      }
    }

local function withResources(targetValues: Mapping, resources: Mapping?): Mapping =
  if (resources == null) targetValues else (targetValues) { ["resources"] = resources }

// Object storage is durable; the local /var/loki data only contains ephemeral state. Disable the
// PVC inherited from base.yaml and mount an explicit emptyDir because the container root filesystem
// is read-only. This also avoids requiring a default StorageClass on object-storage installations.
local function singleBinaryValues(
  isHighAvailability: Boolean,
  isObjectStorage: Boolean,
  backend: storageTypes.StorageBackend,
  clusterInputs: Mapping,
): Mapping =
  storageHelm.decorateTarget(
    new Mapping {
      ["replicas"] = if (isHighAvailability) 0 else 1
      when (isObjectStorage) {
        ["persistence"] = new Mapping { ["enabled"] = false }
        ["extraVolumes"] =
          List(new Mapping {
            ["name"] = "storage"
            ["emptyDir"] = new Mapping {}
          })
        ["extraVolumeMounts"] =
          List(new Mapping {
            ["name"] = "storage"
            ["mountPath"] = "/var/loki"
          })
      }
    },
    backend,
    clusterInputs,
  )

// The chart enables write/backend volume claims by default. In SimpleScalable mode, durable data
// is already in object storage, so retain only ephemeral local state.
local function scalableStatefulTargetValues(
  replicas: Int,
  isObjectStorage: Boolean,
  backend: storageTypes.StorageBackend,
  clusterInputs: Mapping,
): Mapping =
  storageHelm.decorateTarget(
    new Mapping {
      ["replicas"] = replicas
      when (isObjectStorage) {
        ["persistence"] = new Mapping { ["volumeClaimsEnabled"] = false }
      }
    },
    backend,
    clusterInputs,
  )

local function readTargetValues(
  replicas: Int,
  backend: storageTypes.StorageBackend,
  clusterInputs: Mapping,
): Mapping =
  storageHelm.decorateTarget(
    new Mapping { ["replicas"] = replicas },
    backend,
    clusterInputs,
  )
