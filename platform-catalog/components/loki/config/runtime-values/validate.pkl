@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.loki.validate

import "context.pkl"
import "contract.pkl"
import "describe.pkl"
import "profile.pkl"
import "requirements.pkl"
import "storage/backends.pkl" as storageBackends
import "storage/types.pkl" as storage

// VALIDATE and COMPILE share the exact same rules. COMPILE is called again immediately before
// deployment so an old or corrupted stored profile still fails closed.
function violations(
  operation: contract.Operation,
  profileConfig: Mapping,
  clusterContext: Mapping?,
  clusterInputs: Mapping,
) =
  if (operation == contract.describeOperation)
    List()
  else
    unknownFieldViolations(profileConfig)
      + typeViolations(profileConfig)
      + valueViolations(profileConfig, clusterContext)
      + requiredInputViolations(operation, profileConfig, clusterContext, clusterInputs)

local function unknownFieldViolations(profileConfig: Mapping) =
  profileConfig.keys
    .filter((key) -> !describe.fieldKeys.contains(key))
    .map((key) -> new contract.Violation {
      code = "UNKNOWN_FIELD"
      fieldPath = key
      message = "Loki does not define configuration field \(key)"
    })
    .toList()

local function typeViolations(profileConfig: Mapping) =
  List(
    if (profile.retentionWeeks(profileConfig) == null)
      new contract.Violation {
        code = "INVALID_TYPE"
        fieldPath = "retentionWeeks"
        message = "Loki configuration field retentionWeeks must be a whole number"
      }
    else
      null,
    if (profile.highAvailability(profileConfig) == null)
      new contract.Violation {
        code = "INVALID_TYPE"
        fieldPath = "highAvailability"
        message = "Loki configuration field highAvailability must be a bool"
      }
    else
      null,
    if (profile.storage(profileConfig) == null)
      new contract.Violation {
        code = "INVALID_TYPE"
        fieldPath = "storage"
        message = "Loki configuration field storage must be a string"
      }
    else
      null,
  ).filterNonNull()

local function valueViolations(profileConfig: Mapping, clusterContext: Mapping?) =
  let (retentionWeeks = profile.retentionWeeks(profileConfig))
  let (highAvailability = profile.highAvailability(profileConfig))
  let (storageKey = profile.storage(profileConfig))
  let (backend = storageBackends.find(storageKey))
  let (provider = clusterContext?.getOrNull("provider") as String?)
  let (mode = clusterContext?.getOrNull("mode") as context.ClusterMode?)
    List(
      if (
        retentionWeeks != null
          && (
            retentionWeeks < describe.retentionWeeksMin
              || retentionWeeks > describe.retentionWeeksMax
          )
      )
        new contract.Violation {
          code = "VALUE_OUT_OF_RANGE"
          fieldPath = "retentionWeeks"
          message =
            "Loki retentionWeeks must be between \(describe.retentionWeeksMin) and \(describe.retentionWeeksMax)"
        }
      else
        null,
      if (storageKey != null && !storageBackends.allowedValues.contains(storageKey))
        new contract.Violation {
          code = "VALUE_NOT_ALLOWED"
          fieldPath = "storage"
          message = "Loki storage must be one of \(storageBackends.allowedValues.join(", "))"
        }
      else
        null,
      if (highAvailability == true && storageKey == storageBackends.pvc.key)
        new contract.Violation {
          code = "HIGH_AVAILABILITY_REQUIRES_OBJECT_STORAGE"
          fieldPath = "highAvailability"
          message = "Loki high availability requires object storage"
        }
      else
        null,
      storageProviderViolation(storageKey, provider),
      // Managed object storage stays blocked until Terraform outputs are available before Helm
      // compile. The POC implemented here is intentionally customer-managed first.
      if (
        backend is storage.ObjectStorageBackend
          && mode == context.qoveryManagedMode
      )
        new contract.Violation {
          code = "MANAGED_OBJECT_STORAGE_EXECUTION_NOT_AVAILABLE"
          fieldPath = "storage"
          message =
            "Loki object storage on Qovery-managed clusters requires the Terraform output execution barrier"
        }
      else
        null,
    ).filterNonNull()

local function storageProviderViolation(storageKey: String?, provider: String?): contract.Violation? =
  let (backend = storageBackends.find(storageKey))
    if (backend == null || backend.provider == null || backend.provider == provider)
      null
    else
      unsupportedProvider(backend.key, backend.provider, provider)

local function unsupportedProvider(
  storage: String,
  expectedProvider: context.SupportedProvider,
  actualProvider: String?,
) = new contract.Violation {
  code = "STORAGE_PROVIDER_MISMATCH"
  fieldPath = "storage"
  message =
    "Loki storage \(storage) requires provider \(expectedProvider); this cluster uses \(actualProvider)"
}

local function requiredInputViolations(
  operation: contract.Operation,
  profileConfig: Mapping,
  clusterContext: Mapping?,
  clusterInputs: Mapping,
) =
  let (mode = clusterContext?.getOrNull("mode") as context.ClusterMode?)
  let (provider = clusterContext?.getOrNull("provider") as String?)
  let (backend = storageBackends.find(profile.storage(profileConfig)))
    if (
      !shouldValidateRequiredInputs(operation, mode)
        || !backendMatchesProvider(backend, provider)
    )
      List()
    else
      customerInputViolations(
        requirements.requiredInputs(profileConfig, clusterContext),
        clusterInputs,
      )
        + compileOnlyInputViolations(operation, backend, clusterInputs)

// Managed mode reports the execution-barrier violation above. Reporting unavailable outputs as
// missing customer values too would add noise without giving the user another action to take.
local function shouldValidateRequiredInputs(
  operation: contract.Operation,
  mode: context.ClusterMode?,
): Boolean =
  (
    operation == contract.validateOperation
      || operation == contract.compileOperation
  )
    && mode != context.qoveryManagedMode

local function backendMatchesProvider(backend: storage.StorageBackend?, provider: String?): Boolean =
  backend != null
    && (backend.provider == null || backend.provider == provider)

local function customerInputViolations(
  inputs: List<contract.LogicalInput>,
  clusterInputs: Mapping,
): List<contract.Violation> =
  inputs
    .map((input) ->
      if (inputIsBlank(clusterInputs, input.key))
        requiredInputMissing(input.key)
      else
        inputPatternViolation(clusterInputs, input)
    )
    .filterNonNull()
    .toList()

local function compileOnlyInputViolations(
  operation: contract.Operation,
  backend: storage.StorageBackend?,
  clusterInputs: Mapping,
): List<contract.Violation> =
  if (operation != contract.compileOperation || backend == null)
    List()
  else
    backend.compileOnlyInputs.keys
      .map((name) -> backend.compileOnlyInputs[name])
      .filter((input) -> inputIsBlank(clusterInputs, input.key))
      .map((input) -> requiredInputMissing(input.key))
      .toList()

local function requiredInputMissing(key: String): contract.Violation = new contract.Violation {
  code = "REQUIRED_INPUT_MISSING"
  fieldPath = "clusterInputs.\(key)"
  message = "Required input \(key) is missing"
}

local function inputIsBlank(clusterInputs: Mapping, key: String): Boolean =
  let (value = clusterInputs.getOrNull(key))
    if (value is String) value.isBlank else true

local function inputPatternViolation(
  clusterInputs: Mapping,
  input: contract.LogicalInput,
): contract.Violation? =
  let (value = clusterInputs.getOrNull(input.key))
  let (pattern = input.constraints.pattern)
    if (
      value is String
        && !value.isBlank
        && pattern != null
        && !value.matches(Regex(pattern))
    )
      new contract.Violation {
        code = "INPUT_PATTERN_MISMATCH"
        fieldPath = "clusterInputs.\(input.key)"
        message = "Input \(input.key) does not match the expected \(input.type) format"
      }
    else
      null
