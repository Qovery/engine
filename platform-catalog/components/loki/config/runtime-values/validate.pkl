@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.loki.validate

import "context.pkl"
import "contract.pkl"
import "describe.pkl"
import "product.pkl"
import "profile.pkl"
import "resources/validate.pkl" as resourcesValidate
import "sdk/validate.pkl" as sdkValidate
import "storage/validate.pkl" as storageValidate

// Composition only: the operation gate, the rules for the product fields that belong to no feature
// package, and one call per feature package. Adding a feature adds one term here and nothing else.
// VALIDATE and COMPILE share the exact same rules. COMPILE is called again immediately before
// deployment so an old or corrupted stored profile still fails closed.
function violations(
  operation: contract.Operation,
  profileConfig: Mapping,
  clusterContext: Mapping?,
  clusterInputs: Mapping,
): List<contract.Violation> =
  if (operation == contract.describeOperation)
    List()
  else
    let (highAvailability = profile.highAvailability(profileConfig))
    let (mode = clusterContext?.getOrNull("mode") as context.ClusterMode?)
    let (provider = clusterContext?.getOrNull("provider") as String?)
      unknownFieldViolations(profileConfig)
        + productViolations(profileConfig, highAvailability)
        + storageValidate.violations(
          operation,
          profile.storage(profileConfig),
          highAvailability,
          mode,
          provider,
          clusterInputs,
        )
        + resourcesValidate.violations(
          operation,
          profileConfig,
          profile.resourceProfile(profileConfig),
          highAvailability == true,
        )

// The allow-list is the context-free DESCRIBE catalogue, so a value hidden by the current topology
// stays acceptable.
local function unknownFieldViolations(profileConfig: Mapping): List<contract.Violation> =
  sdkValidate.unknownFields(profileConfig, describe.fieldKeys, "Loki")

// retentionWeeks and highAvailability belong to no feature package; product.pkl owns their bounds.
// A null narrowed value means "wrong type", so the range check only runs on a well-typed value.
local function productViolations(
  profileConfig: Mapping,
  highAvailability: Boolean?,
): List<contract.Violation> =
  let (retentionWeeks = profile.retentionWeeks(profileConfig))
    sdkValidate.collect(
      List(
        if (retentionWeeks == null)
          sdkValidate.invalidType(
            "retentionWeeks",
            "Loki configuration field retentionWeeks must be a whole number",
          )
        else
          sdkValidate.intRange(
            "retentionWeeks",
            retentionWeeks,
            product.retentionWeeksMin,
            product.retentionWeeksMax,
            "Loki retentionWeeks must be between \(product.retentionWeeksMin) and \(product.retentionWeeksMax)",
          ),
        if (highAvailability == null)
          sdkValidate.invalidType(
            "highAvailability",
            "Loki configuration field highAvailability must be a bool",
          )
        else
          null,
      ),
    )
