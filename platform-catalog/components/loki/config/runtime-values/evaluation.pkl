@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.loki.evaluation

import "compile.pkl"
import "contract.pkl"
import "describe.pkl"
import "profile.pkl"
import "requirements.pkl"
import "sdk/request.pkl" as sdkRequest
import "sdk/result.pkl" as sdkResult
import "validate.pkl"

// Pure orchestration entrypoint shared by model.pkl and the native Pkl tests. Keeping request
// decoding and JSON rendering outside this function lets the tests exercise the exact catalogue
// path used by q-core without spawning Pkl once per assertion.
// The SDK envelope owns the fail-closed gate: invalid inputs never produce partial Helm values,
// and q-core treats a missing helmValues on a valid COMPILE request as a hard error.
function evaluate(request: Mapping): contract.EvaluationResult =
  let (operation = sdkRequest.operation(request))
  let (profileConfig = sdkRequest.profileConfig(request))
  let (clusterContext = sdkRequest.clusterContext(request))
  let (clusterInputs = sdkRequest.clusterInputs(request))
    sdkResult.envelope(
      operation,
      describe.fieldsFor(
        operation,
        clusterContext,
        profile.resourceProfile(profileConfig),
        profile.highAvailability(profileConfig) == true,
      ),
      if (operation == contract.describeOperation)
        List()
      else
        requirements.requiredInputs(profileConfig, clusterContext),
      validate.violations(operation, profileConfig, clusterContext, clusterInputs),
      () -> compile.compile(profileConfig, clusterInputs),
    )
