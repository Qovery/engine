@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.loki.requirements

import "contract.pkl"
import "profile.pkl"
import "storage/requirements.pkl" as storageRequirements

// RESOLVE_REQUIREMENTS returns only the logical inputs activated by the current draft. Composition
// only: this module resolves the draft and the cluster context, then each feature package decides
// which of its own inputs the selection activates. The release manifest in q-core remains
// responsible for finding the concrete provider of each logical input.
function requiredInputs(
  profileConfig: Mapping,
  clusterContext: Mapping?,
): List<contract.LogicalInput> =
  storageRequirements.requiredInputs(
    profile.storage(profileConfig),
    clusterContext?.getOrNull("provider") as String?,
  )
