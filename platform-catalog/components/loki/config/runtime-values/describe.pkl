@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.loki.describe

import "context.pkl"
import "contract.pkl"
import "product.pkl"
import "resources/fields.pkl" as resourcesFields
import "storage/backends.pkl" as storageBackends

// Presentation only: labels, descriptions, ordering and the constraints rendered to the Console.
// Defaults and bounds are owned by the module that owns the concept — product.pkl for the product
// settings, storage/backends.pkl for the storage default — so this layer stays a pure consumer.

// DESCRIBE exposes all capabilities without context. Contextual operations narrow storage choices
// through the typed backend registry, never through provider conditionals in the Console, and
// narrow the resource fields to the active topology, seeded from the selected profile.
// The Console renders fields in list order: storage comes last so it sits directly above the
// cluster-inputs section its choice activates.
fields: List<contract.Field> =
  productFields + resourcesFields.allFields + List(storageField(storageBackends.allowedValues))

function fieldsFor(
  operation: contract.Operation,
  clusterContext: Mapping?,
  resourceProfileName: String?,
  highAvailability: Boolean,
): List<contract.Field> =
  productFields
    + (
      if (operation == contract.describeOperation)
        resourcesFields.allFields
      else
        resourcesFields.activeFields(resourceProfileName, highAvailability)
    )
    + List(storageField(effectiveStorageAllowedValues(clusterContext)))

local function effectiveStorageAllowedValues(clusterContext: Mapping?): List<String> =
  if (clusterContext == null)
    storageBackends.allowedValues
  else
    storageBackends.allowedValuesForContext(
      clusterContext.getOrNull("mode") as context.ClusterMode?,
      clusterContext.getOrNull("provider") as String?,
    )

local productFields: List<contract.Field> =
  List(
    new contract.Field {
      key = "retentionWeeks"
      type = contract.numberFieldType
      required = false
      defaultValue = "\(product.retentionWeeksDefault)"
      label = "Retention period"
      description = "Whole number of weeks to retain Loki logs."
      constraints = new { min = product.retentionWeeksMin; max = product.retentionWeeksMax }
    },
    new contract.Field {
      key = "highAvailability"
      type = contract.booleanFieldType
      required = false
      defaultValue = "\(product.highAvailabilityDefault)"
      label = "High availability"
      description = "Uses Loki simple-scalable mode and requires object storage."
    },
  )

local function storageField(effectiveStorageValues: List<String>): contract.Field =
  new contract.Field {
    key = "storage"
    type = contract.stringFieldType
    required = false
    defaultValue = storageBackends.defaultKey
    label = "Storage"
    description = "Storage backend used by Loki."
    constraints = new { allowedValues = effectiveStorageValues }
  }

// Used to reject misspelled or obsolete fields instead of silently ignoring them.
fieldKeys: Set<String> = fields.map((field) -> field.key).toSet()
