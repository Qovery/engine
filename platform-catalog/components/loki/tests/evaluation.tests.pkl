amends "pkl:test"

import "../config/runtime-values/contract.pkl"
import "fixtures.pkl"

// End-to-end contract tests: one fact per operation and per envelope property. Per-setting rules
// live in the suite named after the setting folder; golden COMPILE outputs in compile-golden.

local contextFreeDescribe = fixtures.describe(null)
local gcpDescribe = fixtures.describe(fixtures.gcpCustomer)
local s3Requirements = fixtures.resolveRequirements(fixtures.s3Profile, fixtures.awsCustomer)
local s3OnGcp = fixtures.resolveRequirements(fixtures.s3Profile, fixtures.gcpCustomer)
local pvcOnManaged = fixtures.resolveRequirements(fixtures.pvcProfile, fixtures.awsManaged)
local validS3Compile = fixtures.compile(fixtures.s3Profile, fixtures.awsCustomer, fixtures.s3Inputs)
local missingRegionCompile =
  fixtures.compile(fixtures.s3Profile, fixtures.awsCustomer, (fixtures.s3Inputs) { ["infra.awsRegion"] = null })

facts {
  ["DESCRIBE lists every setting in Console order, storage last"] {
    fixtures.fieldKeys(contextFreeDescribe)
      == List("retentionWeeks", "highAvailability", "resources.profile")
        + List("singleBinary", "read", "write", "backend", "gateway").flatMap((target) ->
          List(
            "resources.\(target).requests.cpuMilli",
            "resources.\(target).limits.cpuMilli",
            "resources.\(target).requests.memoryMi",
            "resources.\(target).limits.memoryMi",
          )
        )
        + List("storage")
  }

  ["DESCRIBE renders defaults and bounds from the setting declarations"] {
    fixtures.field(contextFreeDescribe, "retentionWeeks").defaultValue == "12"
    fixtures.field(contextFreeDescribe, "retentionWeeks").constraints.min == 1
    fixtures.field(contextFreeDescribe, "retentionWeeks").constraints.max == 52
    fixtures.field(contextFreeDescribe, "highAvailability").defaultValue == "false"
    fixtures.field(contextFreeDescribe, "resources.profile").defaultValue == "CHART_DEFAULT"
    fixtures.field(contextFreeDescribe, "resources.profile").constraints.allowedValues
      == List("CHART_DEFAULT", "SMALL", "MEDIUM", "LARGE", "CUSTOM")
    fixtures.allowedStorage(contextFreeDescribe) == List("pvc", "s3", "gcs", "azureBlob", "s3Compatible")
  }

  ["DESCRIBE never reports requirements, violations or Helm values"] {
    contextFreeDescribe.requiredInputs.isEmpty
    contextFreeDescribe.violations.isEmpty
    contextFreeDescribe.helmValues == null
  }

  ["a contextual DESCRIBE narrows the storage choices to the cluster provider"] {
    fixtures.allowedStorage(gcpDescribe) == List("pvc", "gcs")
    gcpDescribe.violations.isEmpty
  }

  ["RESOLVE_REQUIREMENTS returns the inputs activated by the selected storage"] {
    fixtures.inputKeys(s3Requirements) == List("infra.s3BucketName", "infra.lokiRoleArn")
    s3Requirements.requiredInputs.every((input) -> input.type == contract.stringFieldType)
    s3Requirements.requiredInputs.every((input) -> input.scope == contract.clusterScope)
    fixtures.allowedStorage(s3Requirements) == List("pvc", "s3")
    s3Requirements.violations.isEmpty
    s3Requirements.helmValues == null
  }

  ["RESOLVE_REQUIREMENTS reports an unavailable choice and activates nothing for it"] {
    fixtures.codes(s3OnGcp) == List("STORAGE_PROVIDER_MISMATCH")
    fixtures.allowedStorage(s3OnGcp) == List("pvc", "gcs")
    s3OnGcp.requiredInputs.isEmpty
    fixtures.allowedStorage(pvcOnManaged) == List("pvc")
    pvcOnManaged.violations.isEmpty
  }

  ["VALIDATE returns stable codes on stable paths, in Console order"] {
    let (
      result =
        fixtures.validate(
          new Mapping { ["retentionWeeks"] = 0; ["highAvailability"] = true; ["storage"] = "pvc" },
          fixtures.awsCustomer,
          new Mapping {},
        )
    )
      fixtures.codes(result) == List("VALUE_OUT_OF_RANGE", "HIGH_AVAILABILITY_REQUIRES_OBJECT_STORAGE")
        && fixtures.paths(result) == List("retentionWeeks", "highAvailability")
        && result.helmValues == null
  }

  ["VALIDATE checks the format of present inputs and the presence of mistyped ones"] {
    let (
      malformed =
        fixtures.validate(
          fixtures.s3Profile,
          fixtures.awsCustomer,
          new Mapping { ["infra.s3BucketName"] = "Upper_Bucket"; ["infra.lokiRoleArn"] = "bad-role" },
        )
    )
      fixtures.codes(malformed) == List("INPUT_PATTERN_MISMATCH", "INPUT_PATTERN_MISMATCH")
        && fixtures.paths(malformed) == List("clusterInputs.infra.s3BucketName", "clusterInputs.infra.lokiRoleArn")
    let (
      mistyped =
        fixtures.validate(
          fixtures.s3Profile,
          fixtures.awsCustomer,
          new Mapping { ["infra.s3BucketName"] = 123; ["infra.lokiRoleArn"] = "arn:aws:iam::123456789012:role/loki" },
        )
    )
      fixtures.codes(mistyped) == List("REQUIRED_INPUT_MISSING")
        && fixtures.paths(mistyped) == List("clusterInputs.infra.s3BucketName")
  }

  ["COMPILE fails closed when a compile-only input is missing"] {
    fixtures.codes(missingRegionCompile) == List("REQUIRED_INPUT_MISSING")
    fixtures.paths(missingRegionCompile) == List("clusterInputs.infra.awsRegion")
    missingRegionCompile.helmValues == null
  }

  ["a valid COMPILE returns the merged Helm fragments"] {
    validS3Compile.violations.isEmpty
    validS3Compile.helmValues == fixtures.helmValues(fixtures.s3Profile, fixtures.s3Inputs)
  }

  ["a contextual COMPILE keeps the narrowed fields and the activated requirements"] {
    let (profile = new Mapping { ["storage"] = "gcs"; ["retentionWeeks"] = 8; ["highAvailability"] = true })
    let (
      inputs = new Mapping {
        ["infra.gcsBucketName"] = "qovery-loki-gcp"
        ["infra.gcpServiceAccountEmail"] = "loki@qovery-project.iam.gserviceaccount.com"
      }
    )
    let (result = fixtures.compile(profile, fixtures.gcpCustomer, inputs))
      result.violations.isEmpty
        && fixtures.allowedStorage(result) == List("pvc", "gcs")
        && fixtures.inputKeys(result) == List("infra.gcsBucketName", "infra.gcpServiceAccountEmail")
        && result.helmValues == fixtures.helmValues(profile, inputs)
  }

  ["Azure Blob COMPILE keeps its contextual fields and requirements"] {
    let (profile = new Mapping { ["storage"] = "azureBlob"; ["retentionWeeks"] = 6; ["highAvailability"] = false })
    let (
      inputs = new Mapping {
        ["infra.azureStorageAccountName"] = "qoveryloki"
        ["infra.azureContainerName"] = "loki-data"
        ["infra.azureManagedIdentityClientId"] = "12345678-1234-1234-1234-123456789abc"
      }
    )
    let (result = fixtures.compile(profile, fixtures.azureCustomer, inputs))
      result.violations.isEmpty
        && fixtures.allowedStorage(result) == List("pvc", "azureBlob")
        && fixtures.inputKeys(result)
          == List("infra.azureStorageAccountName", "infra.azureContainerName", "infra.azureManagedIdentityClientId")
        && result.helmValues == fixtures.helmValues(profile, inputs)
  }

  ["S3-compatible COMPILE keeps its contextual fields and requirements"] {
    let (profile = new Mapping { ["storage"] = "s3Compatible"; ["retentionWeeks"] = 10; ["highAvailability"] = false })
    let (
      inputs = new Mapping {
        ["infra.s3CompatibleBucketName"] = "qovery-loki-scw"
        ["infra.s3CompatibleEndpoint"] = "https://s3.fr-par.scw.cloud"
        ["infra.s3CompatibleRegion"] = "fr-par"
        ["infra.s3CompatibleCredentialsSecretName"] = "loki-object-storage"
      }
    )
    let (result = fixtures.compile(profile, fixtures.scalewayCustomer, inputs))
      result.violations.isEmpty
        && fixtures.allowedStorage(result) == List("pvc", "s3Compatible")
        && fixtures.inputKeys(result)
          == List(
            "infra.s3CompatibleBucketName",
            "infra.s3CompatibleEndpoint",
            "infra.s3CompatibleRegion",
            "infra.s3CompatibleCredentialsSecretName",
          )
        && result.helmValues == fixtures.helmValues(profile, inputs)
  }

  ["an invalid configuration never produces partial Helm values"] {
    let (
      result =
        fixtures.compile(
          (fixtures.pvcProfile) {
            ["resources.profile"] = "CUSTOM"
            ["resources.singleBinary.requests.cpuMilli"] = 500
            ["resources.singleBinary.limits.cpuMilli"] = 300
          },
          fixtures.awsCustomer,
          new Mapping {},
        )
    )
      fixtures.codes(result) == List("REQUIRED_RESOURCE_REQUEST_MISSING", "LIMIT_BELOW_REQUEST")
        && fixtures.paths(result)
          == List("resources.singleBinary.requests.memoryMi", "resources.singleBinary.limits.cpuMilli")
        && result.helmValues == null
  }
}
