@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.karpenterConfiguration.model

import "sdk/evaluate.pkl" as sdkEvaluate
import "sdk/request.pkl" as sdkRequest
import "settings.pkl"

local request = sdkRequest.decode(read("prop:request"))
output {
  value = sdkEvaluate.evaluate(settings.component(sdkRequest.clusterInputs(request)), request)
  renderer = new JsonRenderer {}
}
