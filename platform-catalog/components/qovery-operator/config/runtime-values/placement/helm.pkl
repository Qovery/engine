@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.qoveryOperator.placement.helm

import "../sdk/helm.pkl" as sdkHelm
import "setting.pkl"

// The Deployment and its worker Jobs share one placement. Serialize the same Kubernetes values
// into the Operator environment so it can deserialize them directly into Kubernetes API types.
// Empty settings emit neither scheduling values nor their corresponding environment variables.

tolerationOperator: String = "Equal"

nodeSelectorVariable: String = "QOVERY_ENGINE_WORKER_NODE_SELECTOR"
tolerationsVariable: String = "QOVERY_ENGINE_WORKER_TOLERATIONS"

local jsonRenderer = new JsonRenderer { indent = "" }

fragment: sdkHelm.Fragment = (scope) -> compile(setting.placement(scope))

local function compile(placement: setting.Placement): Mapping =
  let (hasSelector = placement.selectorValue != null)
  let (hasTolerations = !placement.taints.isEmpty)
  let (nodeSelector = new Mapping { [placement.selectorKey] = placement.selectorValue })
  let (
    tolerations = new Listing {
      for (taint in placement.taints) {
        new Mapping {
          ["key"] = taint["key"]
          ["value"] = taint["value"]
          ["effect"] = taint["effect"]
          ["operator"] = tolerationOperator
        }
      }
    }
  )
    new Mapping {
      when (hasSelector) {
        ["nodeSelector"] = nodeSelector
      }
      when (hasTolerations) {
        ["tolerations"] = tolerations
      }
      when (hasSelector || hasTolerations) {
        ["environmentVariables"] = new Mapping {
          when (hasSelector) {
            [nodeSelectorVariable] = jsonRenderer.renderValue(nodeSelector)
          }
          when (hasTolerations) {
            [tolerationsVariable] = jsonRenderer.renderValue(tolerations)
          }
        }
      }
    }
