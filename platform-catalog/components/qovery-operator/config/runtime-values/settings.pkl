@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.qoveryOperator.settings

import "sdk/evaluate.pkl" as sdkEvaluate
import "cpuArchitectures/setting.pkl" as cpuArchitecturesSetting
import "cpuArchitectures/helm.pkl" as cpuArchitecturesHelm
import "placement/setting.pkl" as placementSetting
import "placement/helm.pkl" as placementHelm

// The Operator's per-cluster wiring comes from managed-values.yaml. Its product settings are the
// CPU architecture the local demo builder needs, and where the Operator and its Engine worker Jobs
// must run. Both features contribute to environmentVariables and own disjoint keys there.
component: sdkEvaluate.Component = new {
  label = "Qovery Operator"
  features = List(
    new sdkEvaluate.Feature {
      settings = List(cpuArchitecturesSetting.setting)
      rules = List()
      fragment = cpuArchitecturesHelm.fragment
    },
    new sdkEvaluate.Feature {
      settings = placementSetting.settings
      rules = placementSetting.rules
      fragment = placementHelm.fragment
    },
  )
}
