@ModuleInfo { minPklVersion = "0.32.0" }
module qovery.engine.platform.qoveryOperator.cpuArchitectures.helm

import "../sdk/helm.pkl" as sdkHelm
import "setting.pkl"

fragment: sdkHelm.Fragment = (scope) -> new Mapping {
  ["environmentVariables"] = new Mapping {
    when (setting.setting.selectedValue(scope) != null) {
      ["QOVERY_ENVIRONMENT_ENGINE_WORKER_CPU_ARCHITECTURES"] = setting.setting.selectedValue(scope) as String
    }
  }
}
