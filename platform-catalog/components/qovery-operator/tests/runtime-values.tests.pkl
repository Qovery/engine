amends "pkl:test"

import "../config/runtime-values/contract.pkl"
import "../config/runtime-values/settings.pkl"
import "../config/runtime-values/sdk/evaluate.pkl" as sdkEvaluate
import "../config/runtime-values/sdk/request.pkl" as sdkRequest

local function evaluate(
  operation: contract.Operation,
  profileConfig: Mapping,
  isDemo: Boolean,
): contract.EvaluationResult =
  let (capabilities = if (isDemo) new Listing { "QOVERY_DEMO" } else new Listing {})
    sdkEvaluate.evaluate(
      settings.component,
      sdkRequest.build(
        operation,
        profileConfig,
        new Mapping { ["mode"] = "CUSTOMER_MANAGED"; ["provider"] = "AWS"; ["capabilities"] = capabilities },
        new Mapping {},
        List(),
      ),
    )

local function environment(result: contract.EvaluationResult): Mapping =
  (result.helmValues as Mapping)["environmentVariables"] as Mapping

local function codes(result: contract.EvaluationResult): List<String> = result.violations.map((violation) -> violation.code)

facts {
  ["STANDARD describes the architecture as optional and compiles no demo worker settings"] {
    !evaluate(contract.describeOperation, new Mapping {}, false).fields.first.required
    evaluate(contract.compileOperation, new Mapping {}, false).violations.isEmpty
    environment(evaluate(contract.compileOperation, new Mapping {}, false)).isEmpty
  }

  ["QOVERY_DEMO requires cpuArchitectures"] {
    evaluate(contract.describeOperation, new Mapping {}, true).fields.first.required
    let (result = evaluate(contract.compileOperation, new Mapping {}, true))
      result.helmValues == null
        && codes(result) == List("REQUIRED_FIELD_MISSING")
        && result.violations.first.fieldPath == "cpuArchitectures"
        && result.violations.first.message == "Qovery Operator cpuArchitectures is required for QOVERY_DEMO"
  }

  ["only the two supported architectures are accepted"] {
    codes(evaluate(contract.validateOperation, new Mapping { ["cpuArchitectures"] = "RISCV" }, true)) == List("VALUE_NOT_ALLOWED")
    codes(evaluate(contract.validateOperation, new Mapping { ["cpuArchitectures"] = 64 }, true)) == List("INVALID_TYPE")
  }

  ["QOVERY_DEMO compiles the configured CPU architecture"] {
    let (result = evaluate(contract.compileOperation, new Mapping { ["cpuArchitectures"] = "ARM64" }, true))
      result.violations.isEmpty
        && environment(result)["QOVERY_ENVIRONMENT_ENGINE_WORKER_CPU_ARCHITECTURES"] == "ARM64"
  }
}
